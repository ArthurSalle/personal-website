---
import { getLocale, useTranslations } from "@/i18n/ui";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<button
  type="button"
  data-theme-toggle
  data-light-label={t("theme.toLight")}
  data-dark-label={t("theme.toDark")}
  aria-label={t("theme.toDark")}
  title={t("theme.toDark")}
  class="text-muted hover:bg-surface hover:text-heading flex size-7 cursor-pointer items-center justify-center rounded-md transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
>
  <svg
    class="hidden size-4 dark:block"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="size-4 dark:hidden"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const updateThemeButton = (button: HTMLButtonElement) => {
    const isDark = document.documentElement.dataset.theme === "dark";
    const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;

    if (label) {
      button.setAttribute("aria-label", label);
      button.title = label;
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      updateThemeButton(button);

      button.addEventListener("click", () => {
        const nextTheme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";

        document.documentElement.dataset.theme = nextTheme;
        try {
          localStorage.setItem("theme", nextTheme);
        } catch {
          // Le thème reste actif pour la session si le stockage est indisponible.
        }
        updateThemeButton(button);
      });
    });
</script>
