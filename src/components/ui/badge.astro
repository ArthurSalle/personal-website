---
type Props = {
  tone?: "accent" | "neutral";
};

const { tone = "accent" }: Props = Astro.props;

const toneClass =
  tone === "neutral"
    ? "border-border-strong bg-surface/80 text-body backdrop-blur-sm"
    : "border-blue-500/40 bg-blue-500/10 text-blue-600 dark:border-blue-400/50 dark:bg-blue-400/15 dark:text-blue-400";
---

<div class={`rounded-sm border px-1.5 py-0.5 text-sm ${toneClass}`}>
  <slot />
</div>
