---
type Props = {
  tone?: "accent" | "neutral";
};

const { tone = "accent" }: Props = Astro.props;

const toneClass =
  tone === "neutral"
    ? "border-zinc-700 bg-zinc-900/80 text-zinc-400 backdrop-blur-sm"
    : "border-blue-400/50 bg-blue-400/15 text-blue-400";
---

<div class={`rounded-sm border px-1.5 py-0.5 text-sm ${toneClass}`}>
  <slot />
</div>
