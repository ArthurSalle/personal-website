---
import { Image } from "astro:assets";

type Project = {
  title: string;
  description: string;
  image?: ImageMetadata;
  url?: string;
  accent: string;
};

type Props = {
  project: Project;
  linkLabel?: string;
};

const { project, linkLabel }: Props = Astro.props;
const isExternal = project.url?.startsWith("http");
const glowStyle = `background: radial-gradient(120% 90% at 50% 0%, ${project.accent}2e, transparent 65%);`;
---

<a
  href={project.url}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class={`group flex flex-col gap-2 ${project.url ? "cursor-pointer" : "cursor-default"}`}
>
  <div
    class="relative h-44 overflow-hidden rounded-md border border-zinc-800 bg-zinc-900"
  >
    <div class="absolute inset-0" style={glowStyle}></div>

    {
      project.image ? (
        <Image
          src={project.image}
          alt={project.title}
          width={720}
          format="webp"
          class="absolute inset-x-5 top-5 h-[calc(100%-1.25rem)] w-[calc(100%-2.5rem)] rounded-t-sm border border-zinc-700/60 object-cover object-top shadow-2xl shadow-black/50 transition-transform duration-300 group-hover:-translate-y-1"
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="font-manrope text-lg font-semibold text-zinc-500">
            {project.title}
          </span>
        </div>
      )
    }
  </div>

  <div>
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="font-manrope font-medium text-zinc-100">{project.title}</h3>
      {
        linkLabel && (
          <span class="text-xs text-zinc-500 transition-colors duration-200 group-hover:text-zinc-300">
            {linkLabel} →
          </span>
        )
      }
    </div>
    <p class="text-sm text-zinc-400">{project.description}</p>
  </div>
</a>
