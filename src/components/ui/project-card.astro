---
import { Image } from "astro:assets";

import Badge from "./badge.astro";

type Project = {
  title: string;
  description: string;
  image?: ImageMetadata;
  preview?: "screenshot" | "art";
  url?: string;
  accent: string;
  label?: string;
};

type Props = {
  project: Project;
  linkLabel?: string;
};

const { project, linkLabel }: Props = Astro.props;
const isExternal = project.url?.startsWith("http");
const glowStyle = `background: radial-gradient(120% 90% at 50% 0%, ${project.accent}2e, transparent 65%);`;

// Les captures sont cadrées comme un écran, les visuels carrés posés en tuile centrée
const imageClass =
  project.preview === "art"
    ? "absolute top-1/2 left-1/2 h-[78%] w-auto -translate-x-1/2 -translate-y-1/2 rounded-2xl object-contain shadow-2xl shadow-black/15 transition-transform duration-300 group-hover:scale-105 dark:shadow-black/50"
    : "absolute inset-x-5 top-5 h-[calc(100%-1.25rem)] w-[calc(100%-2.5rem)] rounded-t-sm border border-border-strong/60 object-cover object-top shadow-2xl shadow-black/15 transition-transform duration-300 group-hover:-translate-y-1 dark:shadow-black/50";
---

<a
  href={project.url}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class={`group flex flex-col gap-2 ${project.url ? "cursor-pointer" : "cursor-default"}`}
>
  <div
    class="border-border bg-media relative h-44 overflow-hidden rounded-md border"
  >
    <div class="absolute inset-0" style={glowStyle}></div>

    {
      project.image ? (
        <Image
          src={project.image}
          alt={project.title}
          width={720}
          format="webp"
          class={imageClass}
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="font-manrope text-muted text-lg font-semibold">
            {project.title}
          </span>
        </div>
      )
    }
  </div>

  <div>
    <div class="flex items-baseline justify-between gap-2">
      <div class="flex items-baseline gap-2">
        <h3 class="font-manrope text-heading font-medium">{project.title}</h3>
        {
          project.label && (
            <Badge tone="neutral">
              <span class="text-xs">{project.label}</span>
            </Badge>
          )
        }
      </div>
      {
        linkLabel && (
          <span class="text-muted group-hover:text-heading text-xs transition-colors duration-200">
            {linkLabel} →
          </span>
        )
      }
    </div>
    <p class="text-body text-sm">{project.description}</p>
  </div>
</a>
