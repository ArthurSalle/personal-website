---
import { Image } from "astro:assets";

import profilePic from "@/assets/c-arthur.webp";
import { getLocale, useTranslations } from "@/i18n/ui";
import LinkButton from "./ui/link-button.astro";
import ThemeToggle from "./ui/theme-toggle.astro";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<header class="flex w-full max-w-xl flex-col gap-12">
  <div
    class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4"
  >
    <div class="flex items-center gap-4">
      <Image
        src={profilePic}
        alt="Arthur Sallé"
        width={160}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="border-accent aspect-square size-16 rounded-full border-2 object-cover select-none md:size-20"
      />
      <div class="font-manrope">
        <h1 class="text-heading text-2xl font-medium md:text-3xl">
          Arthur Sallé
        </h1>
        <h2 class="text-muted md:text-lg">{t("header.role")}</h2>
        <span
          class="mt-1.5 flex w-fit items-center gap-1.5 rounded-full border border-emerald-600/30 bg-emerald-600/10 px-2.5 py-0.5 text-xs font-medium text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-400"
        >
          <span class="relative flex size-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75 dark:bg-emerald-400"
            ></span>
            <span
              class="relative inline-flex size-2 rounded-full bg-emerald-500 dark:bg-emerald-400"
            ></span>
          </span>
          {t("header.available")}
        </span>
      </div>
    </div>

    <nav class="text-muted flex items-center justify-end gap-1 text-sm">
      <a
        href={locale === "fr" ? "/en/" : "/"}
        class="hover:text-heading rounded px-1.5 py-0.5 transition-colors duration-200"
        >{locale === "fr" ? "EN" : "FR"}</a
      >
      <ThemeToggle />
    </nav>
  </div>

  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-4">
      <p>{t("header.greeting")}</p>
      <p>{t("header.bio1")}</p>
      <p>{t("header.bio2")}</p>
      <p>{t("header.bio3")}</p>
      <p>{t("header.bio4")}</p>
      <p>{t("header.bio5")}</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <LinkButton href="https://www.linkedin.com/in/arthursalle/"
        >LinkedIn</LinkButton
      >
      <LinkButton href="https://www.malt.fr/profile/arthursalle"
        >Malt</LinkButton
      >
      <LinkButton href="https://github.com/ArthurSalle">GitHub</LinkButton>
    </div>
  </div>
</header>
