---
import { getLocale, useTranslations } from "@/i18n/ui";
import LinkButton from "./ui/link-button.astro";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const email = "arthur.salle95@gmail.com";
const bookingUrl = "https://cal.eu/arthursalle/meeting";
---

<div class="flex w-full max-w-xl flex-col gap-4">
  <h2 class="font-manrope text-lg font-semibold text-zinc-100">
    {t("contact.title")}
  </h2>

  <p>
    {t("contact.text")}
    <a
      href={`mailto:${email}`}
      class="text-zinc-300 underline underline-offset-2 transition-colors duration-200 hover:text-white"
      >{t("contact.email")}</a
    >.
  </p>

  <LinkButton href={bookingUrl}>{t("contact.book")}</LinkButton>
</div>
