---
import { caseStudies } from "@/data/projects";
import { getLocale, useTranslations } from "@/i18n/ui";
import ProjectCard from "./ui/project-card.astro";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const basePath = locale === "en" ? "/en/projects" : "/projects";
---

<div class="flex w-full max-w-xl flex-col gap-4">
  <h2 class="font-manrope text-lg font-semibold text-zinc-100">
    {t("projects.title")}
  </h2>

  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      caseStudies.map((project) => (
        <ProjectCard
          project={{
            title: project.title,
            description: project.tagline[locale],
            image: project.image,
            url: `${basePath}/${project.slug}/`,
            accent: project.accent,
            label: project.label?.[locale],
          }}
          linkLabel={t("projects.caseStudy")}
        />
      ))
    }
  </div>
</div>
