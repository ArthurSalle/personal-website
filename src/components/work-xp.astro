---
import { experiences } from "@/data/experiences";
import { getLocale, useTranslations } from "@/i18n/ui";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<div class="flex w-full max-w-xl flex-col gap-4">
  <h2 class="font-manrope text-heading text-lg font-semibold">
    {t("xp.title")}
  </h2>

  <div class="flex flex-col gap-2">
    {
      experiences.map((xp) => (
        <div class="border-border flex flex-col gap-2 rounded-xl border p-4">
          <div class="flex justify-between gap-4">
            <div class="flex flex-col">
              <span class="font-manrope text-heading font-medium">
                {xp.role[locale]}
              </span>
              {xp.url ? (
                <a
                  href={xp.url}
                  target="_blank"
                  class="hover:text-heading [&_svg]:stroke-body hover:[&_svg]:stroke-heading flex items-center gap-1 text-sm transition-colors duration-200 [&_svg]:size-2.5 [&_svg]:transition-colors [&_svg]:duration-200"
                >
                  {xp.company}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M13 5H19V11" />
                    <path d="M19 5L5 19" />
                  </svg>
                </a>
              ) : (
                <span class="text-sm">{xp.company}</span>
              )}
            </div>
            <div class="flex shrink-0 flex-col items-end text-sm">
              <span>{xp.period[locale]}</span>
            </div>
          </div>
          <p class="text-body text-sm">{xp.description[locale]}</p>
        </div>
      ))
    }
  </div>
</div>
