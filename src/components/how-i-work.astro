---
import { howIWorkIntro, howIWorkSteps } from "@/data/how-i-work";
import { getLocale, useTranslations } from "@/i18n/ui";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<div class="flex w-full max-w-xl flex-col gap-4">
  <h2 class="font-manrope text-heading text-lg font-semibold">
    {t("how.title")}
  </h2>

  <p>{howIWorkIntro[locale]}</p>

  <ol class="flex flex-col gap-2">
    {
      howIWorkSteps.map((step, i) => (
        <li class="border-border flex gap-4 rounded-xl border p-4">
          <span class="text-muted font-mono text-sm">0{i + 1}</span>
          <div class="flex flex-col gap-1">
            <span class="font-manrope text-heading font-medium">
              {step.title[locale]}
            </span>
            <p class="text-body text-sm">{step.description[locale]}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>
